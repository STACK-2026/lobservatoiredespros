---
/**
 * EditorialTicker , extraits factuels du registre public.
 *
 * Le bandeau ne simule aucune activité en temps réel. Il expose uniquement
 * des attributs présents dans Supabase et reste déterministe entre deux
 * modifications de données.
 */
import { supabase } from "../lib/supabase";

interface TickerEvent {
  type: "observation" | "certification";
  label: string;
  detail: string;
  slug: string;
}

// Extraits réels et ordonnés de façon stable.
const { data: pros } = await supabase
  .from("pros")
  .select("nom_entreprise, ville, code_postal, score_confiance, siret, rge, date_creation_entreprise, slug")
  .eq("active", true)
  .not("slug", "is", null)
  .order("score_confiance", { ascending: false })
  .order("id")
  .limit(18);

const events: TickerEvent[] = [];
if (pros && pros.length > 0) {
  pros.forEach((p: any) => {
    const score = Number(p.score_confiance || 0).toFixed(1);
    const ville = p.ville ? p.ville.replace(/-/g, " ") : "";
    const cp = p.code_postal ? p.code_postal.slice(0, 2) : "";
    const lieu = ville ? `${ville}${cp ? ` (${cp})` : ""}` : cp || "France";
    const creation = p.date_creation_entreprise
      ? `créé en ${String(p.date_creation_entreprise).slice(0, 4)}`
      : null;
    const detail = [
      p.nom_entreprise,
      lieu,
      creation,
      `Score publié ${score}/10`,
    ]
      .filter(Boolean)
      .join(" · ");

    events.push({
      type: p.rge ? "certification" : "observation",
      label: p.rge ? "RGE répertorié" : "Établissement observé",
      detail,
      slug: p.slug,
    });
  });
}

// Dupliquer pour boucle infinie visuelle sans trou
const loop = [...events, ...events];
---

{events.length > 0 && (
  <div class="editorial-ticker" role="complementary" aria-label="Extraits du registre public" aria-live="off">
    <div class="et-label">
      <span class="et-source-dot" aria-hidden="true"></span>
      <span class="et-label-text">Registre public</span>
      <span class="et-label-sep" aria-hidden="true"></span>
      <span class="et-edition folio">Extraits factuels</span>
    </div>
    <div class="et-track-wrapper">
      <div class="et-track">
        {loop.map((e) => {
          const href = `/pro/${e.slug}/`;
          const ariaLabel = `${e.label} , ${e.detail}`;
          return (
            <a class={`et-item et-item-${e.type}`} href={href} aria-label={ariaLabel}>
              <span class="et-type-dot" aria-hidden="true"></span>
              <span class="et-item-label">{e.label}</span>
              <span class="et-item-sep" aria-hidden="true">·</span>
              <span class="et-item-detail">{e.detail}</span>
              <span class="et-item-arrow" aria-hidden="true">&rarr;</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
)}

<style>
  .editorial-ticker {
    background: var(--ink);
    color: var(--paper);
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    border-bottom: 1px solid rgba(184, 134, 61, 0.35);
    font-family: var(--font-body);
    font-size: 0.78rem;
    position: relative;
    z-index: 40;
    overflow: hidden;
  }

  .et-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1rem 0.55rem 1.1rem;
    background: linear-gradient(90deg, var(--ink) 70%, rgba(26, 22, 20, 0) 100%);
    position: relative;
    z-index: 2;
    white-space: nowrap;
  }
  .et-source-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--or);
    flex-shrink: 0;
  }
  .et-label-text {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.68rem;
    color: var(--or-soft);
  }
  .et-label-sep {
    display: inline-block;
    width: 1px;
    height: 12px;
    background: rgba(247, 243, 236, 0.2);
  }
  .et-edition {
    color: rgba(247, 243, 236, 0.55);
    font-size: 0.7rem;
  }

  .et-track-wrapper {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0, black 40px, black calc(100% - 60px), transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 40px, black calc(100% - 60px), transparent 100%);
  }
  .et-track {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    white-space: nowrap;
    animation: ticker-scroll 75s linear infinite;
    padding-left: 1.5rem;
    will-change: transform;
  }
  .editorial-ticker:hover .et-track { animation-play-state: paused; }
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .et-item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.76rem;
    letter-spacing: 0.008em;
    flex-shrink: 0;
    text-decoration: none;
    color: inherit;
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    transition: background 220ms, transform 220ms;
    cursor: pointer;
  }
  .et-item:hover {
    background: rgba(184, 134, 61, 0.14);
    transform: translateY(-1px);
  }
  .et-item:focus-visible {
    outline: 2px solid var(--or);
    outline-offset: 2px;
  }
  .et-item-arrow {
    display: inline-block;
    color: var(--or-soft);
    opacity: 0;
    margin-left: -0.4rem;
    transform: translateX(-3px);
    transition: opacity 220ms, transform 220ms, margin-left 220ms;
  }
  .et-item:hover .et-item-arrow {
    opacity: 1;
    margin-left: 0.1rem;
    transform: translateX(0);
  }
  .et-type-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .et-item-observation .et-type-dot { background: var(--or); }
  .et-item-certification .et-type-dot { background: #4A913A; }

  .et-item-label {
    color: var(--paper);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .et-item-observation .et-item-label { color: var(--or-soft); }
  .et-item-certification .et-item-label { color: #A4D595; }

  .et-item-sep {
    color: rgba(247, 243, 236, 0.3);
    margin: 0 -0.1rem;
  }
  .et-item-detail {
    color: rgba(247, 243, 236, 0.8);
  }

  @media (max-width: 720px) {
    .et-label { padding: 0.55rem 0.8rem 0.5rem 0.9rem; }
    .et-edition { display: none; }
    .et-label-sep { display: none; }
    .et-track { gap: 1.8rem; }
    .et-item { font-size: 0.72rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .et-track { animation: none; overflow-x: auto; }
  }
</style>
